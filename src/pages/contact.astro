---
import Base from '../layouts/Base.astro';

// No form, by decision. A form needs a backend, and a backend that fails
// silently loses an enquiry without anyone ever knowing it existed. A mailto
// either opens or visibly does not.
const description =
  'Booking enquiries for Shaheen Kiarash, model based in Stockholm. Email or Instagram, no forms.';

const EMAIL = 'shaheen@shaheenkiarash.com';
const MAILTO = `mailto:${EMAIL}?subject=${encodeURIComponent('Booking inquiry - Shaheen Kiarash')}`;
const INSTAGRAM = 'https://www.instagram.com/shaheen.kiarash/';
---

<Base title="Contact" description={description} path="/contact">
  <article class="page">
    <header class="page-head">
      <p class="eyebrow">04 · Contact</p>
      <h1>Let's talk about<br /><em>the shoot.</em></h1>
      <p class="lede">
        Tell me the dates, the location and what the day looks like. That is
        usually enough for me to give you a straight yes or no.
      </p>
    </header>

    <div class="routes">
      <a class="route route-primary" href={MAILTO}>
        <span class="route-label">Email · fastest</span>
        <span class="route-value">{EMAIL}</span>
        <span class="route-note">Opens with a booking subject line already set.</span>
      </a>

      <a class="route" href={INSTAGRAM} rel="me noopener" target="_blank">
        <span class="route-label">Instagram</span>
        <span class="route-value">@shaheen.kiarash</span>
        <span class="route-note">Current work, and DMs are open.</span>
      </a>
    </div>

    <dl class="facts">
      <div>
        <dt>Based in</dt>
        <dd>Stockholm, Sweden</dd>
      </div>
      <div>
        <dt>Travels</dt>
        <dd>Nordics, Mediterranean, and further for the right job</dd>
      </div>
      <div>
        <dt>Languages</dt>
        <dd>Arabic · English · Swedish</dd>
      </div>
      <div>
        <dt>Worked with</dt>
        <dd>Shady Rays · Lullevibes</dd>
      </div>
    </dl>
  </article>
</Base>

<style>
  .page {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: var(--s-6) var(--gutter) var(--s-5);
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: var(--s-3);
  }

  .page-head h1 {
    font-size: clamp(2.6rem, 8vw, 6rem);
    letter-spacing: -0.02em;
  }
  .page-head em { font-style: italic; color: var(--ink-soft); }

  .lede {
    margin-top: var(--s-3);
    color: var(--ink-soft);
    max-width: 46ch;
    line-height: 1.6;
  }

  .routes {
    margin-top: var(--s-7);
    display: grid;
    gap: 1px;
    background: var(--line-soft);
    border-block: 1px solid var(--line-soft);
  }
  @media (min-width: 48rem) {
    .routes { grid-template-columns: 1fr 1fr; }
  }

  .route {
    display: grid;
    gap: 0.55rem;
    padding: var(--s-4) var(--s-3) var(--s-4) 0;
    background: var(--bg);
    text-decoration: none;
    transition: background 0.4s var(--ease);
  }
  @media (min-width: 48rem) {
    .route { padding-inline: var(--s-3); }
    .route:first-child { padding-left: 0; }
  }
  .route:hover,
  .route:focus-visible { background: var(--bg-elevated); }

  .route-label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .route-value {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 3.4vw, 2.1rem);
    color: var(--ink);
    line-height: 1.15;
    /* Long addresses break rather than widening the page. */
    overflow-wrap: anywhere;
  }
  .route-note { font-size: 0.8rem; color: var(--muted); }

  .facts {
    margin-top: var(--s-6);
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 48rem) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  }
  .facts dt {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.4rem;
  }
  .facts dd {
    margin: 0;
    color: var(--ink-soft);
    max-width: 40ch;
  }
</style>
