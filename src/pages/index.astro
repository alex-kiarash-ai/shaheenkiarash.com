---
// Still the placeholder, but now inside the shared shell so it carries the
// nav, the contact block and the same head tags as every other page. The real
// home page arrives with the photographs; the noindex comes off then, and
// removing it is the switch that makes the site publicly discoverable.
import Base from '../layouts/Base.astro';

const description = 'Shaheen Kiarash, model based in Stockholm. Hair, fitness and commercial.';
---

<Base title="Home" description={description} path="/" noindex>
  <section class="hero">
    <p class="eyebrow">01 · Portfolio in progress</p>
    <h1>Shaheen<br />Kiarash</h1>
    <p class="line">Hair · Fitness · Commercial</p>
    <p class="meta">
      The new portfolio is being rebuilt. Built with Astro, compiled to static
      HTML and CSS, served from Cloudflare's edge, deployed by GitHub Actions.
      Bookings are open in the meantime.
    </p>
  </section>
</Base>

<style>
  .hero {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: var(--s-7) var(--gutter) var(--s-6);
    min-height: 62svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .eyebrow {
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: var(--s-3);
  }

  h1 {
    font-size: clamp(3rem, 13vw, 9rem);
    letter-spacing: -0.025em;
    line-height: 0.92;
  }

  .line {
    color: var(--ink-soft);
    margin-top: var(--s-3);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .meta {
    color: var(--faint);
    margin-top: var(--s-4);
    font-size: 0.85rem;
    max-width: 48ch;
    line-height: 1.65;
  }
</style>
