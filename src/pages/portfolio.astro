---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

// The order lives in the content, not here. It is the curation carried over
// from the live site: an interleave that never puts two shirtless frames
// together while a clothed frame is still unplaced. Sorting by anything else
// would quietly discard that work.
const photos = (await getCollection('photos')).sort(
  (a, b) => a.data.order - b.data.order
);

const description =
  'Selected work by Shaheen Kiarash, model based in Stockholm. Hair, fitness and commercial.';
---

<Base title="Portfolio" description={description} path="/portfolio">
  <article class="page">
    <header class="page-head">
      <p class="eyebrow">02 · Selected work</p>
      <h1>Selected<br /><em>work.</em></h1>
      <p class="count">
        {photos.length} frames · Hair, fitness and commercial
      </p>
    </header>

    <div class="grid">
      {photos.map((photo, i) => (
        <figure class="frame">
          <Image
            src={photo.data.src}
            alt={photo.data.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
            formats={['avif', 'webp']}
            quality={82}
            /* The first two are above the fold on every viewport and are the
               page's largest paint. Everything after them is lazy, because
               eagerly loading 24 photographs is how a portfolio ends up
               slower than the work it is showing. */
            loading={i < 2 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
          {photo.data.tags.length > 0 && (
            <figcaption>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="cat">{photo.data.tags[0]}</span>
              {photo.data.caption && <span class="season">{photo.data.caption}</span>}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  </article>
</Base>

<style>
  .page {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: var(--s-6) var(--gutter) var(--s-5);
  }

  .eyebrow {
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: var(--s-3);
  }

  .page-head h1 {
    font-size: clamp(2.6rem, 8vw, 6rem);
    letter-spacing: -0.02em;
  }
  .page-head em { font-style: italic; color: var(--ink-soft); }

  .count {
    margin-top: var(--s-3);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .grid {
    margin-top: var(--s-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4) var(--s-3);
  }
  @media (min-width: 40rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5) var(--s-4); }
  }

  .frame { margin: 0; }

  /* The 4:5 box is declared here rather than left to the file, so one
     differently-cropped photograph cannot break the rhythm of the whole grid.
     object-fit does the rest. */
  .frame :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    background: var(--bg-elevated);
    filter: saturate(0.96);
    transition: filter 0.5s var(--ease), transform 0.6s var(--ease);
  }
  .frame:hover :global(img) { filter: saturate(1.04); transform: scale(1.008); }

  figcaption {
    display: flex;
    gap: var(--s-2);
    align-items: baseline;
    margin-top: 0.7rem;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .num { color: var(--faint); font-variant-numeric: tabular-nums; }
  .cat { color: var(--muted); }
  .season { color: var(--faint); margin-left: auto; text-transform: none; letter-spacing: 0.04em; }

  @media (prefers-reduced-motion: reduce) {
    .frame:hover :global(img) { transform: none; }
  }
</style>
